{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NumDeck",
  "version": "1.2.0",
  "identifier": "com.naveen.numdeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NumDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Turn your ordinary numpad into a customizable Stream Deck-style shortcut controller for Windows.",
    "longDescription": "NumDeck turns any ordinary physical numeric keypad into a customizable Stream Deck-style shortcut controller for Windows. Trigger macros, launch apps, control audio, and execute complex workflows without purchasing separate hardware.",
    "copyright": "Copyright © 2026 Naveen. All rights reserved.",
    "category": "Utility",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
